# Copy to `.env` for the plain-uvicorn local dev path (local/dev.py).
# Same format as .dev.vars.

OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

API_TOKEN=change-me
RUNNER_TOKEN=change-me-runner
SECRET_ENCRYPTION_KEY=generate-a-fernet-key
CI_WEBHOOK_SECRET=change-me
ALLOWED_ORIGINS=http://localhost:5173
# Development only; never set this in production.
# ALLOW_INSECURE_LOCAL=true
# RATE_LIMIT_PER_MINUTE=120
